http://photoflex.site {
    encode zstd gzip
    header Cache-Control "no-cache"

    handle /assets/* {
        root * /srv/photoflex/shared
        @existing file
        header @existing Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv/photoflex/current
        try_files {path} /index.html
        file_server
    }
}
