{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoFlex Tech Reversal",
  "version": "0.1.0",
  "identifier": "com.photoflex.techreversal",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @photoflex/benchmark-ui dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "corepack pnpm --filter @photoflex/benchmark-ui build",
    "frontendDist": "../../benchmark-ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "PhotoFlex Tech Reversal", "width": 1480, "height": 980, "minWidth": 1100, "minHeight": 720 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: photoflex-source: http://photoflex-source.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
